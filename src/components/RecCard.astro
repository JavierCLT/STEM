---
import type { Rec } from '../data/reading';
interface Props { rec: Rec; headingLevel?: 'h3' | 'h4' }
const { rec, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<li class="rec">
  <H class="rec-title"><cite>{rec.title}</cite></H>
  <p class="rec-meta">{rec.author} · {rec.publisher}, {rec.year} · <span class="age">{rec.ages}</span></p>
  <p class="rec-about">{rec.about}</p>
  {rec.awards && <p class="rec-awards">{rec.awards.join(' · ')}</p>}
  {rec.note && <p class="rec-note">{rec.note}</p>}
</li>

<style>
  .rec { padding: 1.1rem 1.25rem; border-radius: 12px; background: var(--card); border: 1px solid var(--line-light); }
  .rec-title { font-size: 1.05rem; line-height: 1.3; margin: 0 0 0.3rem; letter-spacing: -0.01em; }
  .rec-title cite { font-style: normal; }
  .rec-meta { font-size: 0.86rem; color: var(--ink-3); margin: 0 0 0.5rem; }
  .rec-meta .age { font-weight: 700; color: var(--ink-2); }
  .rec-about { margin: 0; font-size: 0.97rem; color: var(--ink); }
  .rec-awards { margin: 0.55rem 0 0; font-size: 0.82rem; font-weight: 700; color: var(--accent-ink); }
  .rec-note { margin: 0.45rem 0 0; font-size: 0.85rem; color: var(--ink-3); font-style: italic; }
</style>
